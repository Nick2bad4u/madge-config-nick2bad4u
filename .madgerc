{
    "$schema": "https://www.schemastore.org/madge.json",
    "backgroundColor": "#0b0f19",
    "baseDir": ".",
    "cyclicNodeColor": "#ff5f6d",
    "dependencyFilter": false,
    "detectiveOptions": {
        "ts": {
            "skipTypeImports": false
        },
        "tsx": {
            "skipTypeImports": false
        }
    },
    "edgeColor": "#4c5d80",
    "excludeRegExp": [
        "^\\.cache/",
        "^coverage/",
        "^dist/",
        "^storybook-static/",
        "^temp/",
        "^playwright/",
        "^benchmarks/",
        "^docs/",
        "^scripts/",
        ".*\\.test\\.[tj]sx?$",
        ".*\\.spec\\.[tj]sx?$",
        ".*\\.stories\\.[tj]sx?$",
        "^tailwindcss$",
        "^tailwind-scrollbar-hide(/v4)?$",
        "^tw-animate-css$"
    ],
    "fileExtensions": [
        "ts",
        "tsx",
        "mts",
        "cts",
        "js",
        "jsx",
        "mjs",
        "cjs"
    ],
    "fontName": "Inter",
    "fontSize": "12px",
    "graphVizOptions": {
        "E": {
            "arrowhead": "vee",
            "arrowsize": "1.0",
            "color": "#4c5d80",
            "decorate": "true",
            "fontcolor": "#94a3c4",
            "penwidth": "1.3"
        },
        "G": {
            "bgcolor": "#0b0f19",
            "color": "#172041",
            "concentrate": "true",
            "dpi": "96",
            "fontcolor": "#e8f1ff",
            "fontname": "Inter",
            "fontsize": "12",
            "labeljust": "l",
            "labelloc": "t",
            "layout": "dot",
            "margin": "0.2,0.1",
            "nodesep": "0.5",
            "overlap": "false",
            "pad": "0.5",
            "penwidth": "1.2",
            "rankdir": "LR",
            "ranksep": "1.0",
            "ratio": "fill",
            "size": "10,10",
            "splines": "spline"
        },
        "N": {
            "color": "#1f4aff",
            "fillcolor": "#132145",
            "fontcolor": "#e8f1ff",
            "fontname": "Inter",
            "fontsize": "11",
            "height": "0.5",
            "margin": "0.1",
            "shape": "box",
            "style": "rounded,filled",
            "width": "0.75"
        }
    },
    "graphVizPath": false,
    "includeNpm": true,
    "layout": "dot",
    "noDependencyColor": "#00bfa6",
    "nodeColor": "#1f4aff",
    "nodeShape": "box",
    "nodeStyle": "rounded",
    "rankdir": "LR",
    "requireConfig": null,
    "tsConfig": "./tsconfig.json",
    "webpackConfig": null
}
